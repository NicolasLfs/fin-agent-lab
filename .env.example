# PostgreSQL and local Compose
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
DATABASE_URL=postgres://fin_agent:change-me-locally@localhost:5432/fin_agent?sslmode=disable

# Go API and market-data worker
AGENT_URL=http://localhost:8000
LOCALSTACK_URL=http://localhost:4566
HTTP_ADDR=:8080
BRAPI_API_KEY=
MARKET_DATA_SYNC_INTERVAL=15m

# Python agent and shared dependencies
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
OPENROUTER_TIMEOUT_SECONDS=25
NEWS_PROCESSING_QUEUE_URL=http://localhost:4566/000000000000/news-processing-queue
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAIT_TIME_SECONDS=20

# Optional integration-test endpoints
TEST_DATABASE_URL=postgres://fin_agent:change-me-locally@localhost:5432/fin_agent?sslmode=disable
QDRANT_TEST_URL=http://localhost:6333
